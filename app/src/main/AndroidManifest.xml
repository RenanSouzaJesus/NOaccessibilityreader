<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NoApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_no_app"
        android:label="NÓ"
        android:theme="@style/Theme.NO">

        <activity
            android:name=".CampaignAnalysisPremiumActivity"
            android:exported="false" />

        <activity
            android:name=".AdvertiserActivityPremium"
            android:exported="false" />

        <activity
            android:name=".CampaignsActivityPremium"
            android:exported="false" />

        <activity
            android:name=".CampaignAnalysisActivity"
            android:exported="false" />

        <activity
            android:name=".AdvertiserActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivityV2"
            android:exported="false" />

        <activity
            android:name=".MainActivityPremium"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ScreenAccessibilityService"
            android:label="NÓ • Leitura autorizada"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".NoNotificationListenerService"
            android:label="NÓ • Notificações de oportunidades"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
