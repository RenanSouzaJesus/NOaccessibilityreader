<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/no_navy"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="34dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    style="@style/NoLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NÓ" />

                <TextView
                    style="@style/NoLogoDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="." />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_no_chip"
                android:text="CENTRAL"
                android:textColor="@color/no_cyan_soft"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/NoHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Oportunidades em um só lugar" />

        <TextView
            style="@style/NoBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="O NÓ reúne corridas, entregas e rotas capturadas com sua autorização e destaca o melhor retorno disponível." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:background="@color/no_cyan" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/no_orange" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_no_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NoSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAPTURA AUTORIZADA" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Leitura da tela"
                    android:textColor="@color/no_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/accessibilityStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_no_status_inactive"
                    android:text="VERIFICANDO"
                    android:textColor="@color/no_orange"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Alertas dos aplicativos"
                    android:textColor="@color/no_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/notificationStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_no_status_inactive"
                    android:text="VERIFICANDO"
                    android:textColor="@color/no_orange"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/accessibilityButton"
                    style="@style/NoSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1"
                    android:text="Acessibilidade" />

                <Button
                    android:id="@+id/notificationButton"
                    style="@style/NoSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"
                    android:text="Notificações" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bestCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_no_badge_high"
            android:orientation="vertical"
            android:padding="17dp"
            android:visibility="gone">

            <TextView
                style="@style/NoSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MELHOR OPORTUNIDADE AGORA" />

            <TextView
                android:id="@+id/bestPlatformText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="99 • 99Pop"
                android:textColor="@color/no_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bestPriceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-condensed"
                android:text="R$ 0,00"
                android:textColor="@color/no_white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bestMetricsText"
                style="@style/NoBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0,0 km • R$ 0,00/km • R$ 0,00/h" />

            <TextView
                android:id="@+id/bestReasonText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Melhor equilíbrio entre retorno por km e retorno por hora."
                android:textColor="@color/no_cyan_soft"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/NoSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="OPORTUNIDADES RECENTES" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabAll"
                style="@style/NoPrimaryButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:text="Todas" />

            <Button
                android:id="@+id/tabRides"
                style="@style/NoSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:text="Corridas" />

            <Button
                android:id="@+id/tabDeliveries"
                style="@style/NoSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:text="Entregas" />

            <Button
                android:id="@+id/tabRoutes"
                style="@style/NoSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="3dp"
                android:layout_weight="1"
                android:text="Rotas" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyInboxText"
            style="@style/NoBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_no_metric"
            android:padding="16dp"
            android:text="Nenhuma oportunidade recente. Abra uma simulação da Uber ou 99 para começar." />

        <LinearLayout
            android:id="@+id/opportunitiesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_no_metric"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/NoSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ÚLTIMO ALERTA DE APLICATIVO" />

            <TextView
                android:id="@+id/sourceNotificationText"
                style="@style/NoBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Nenhum alerta compatível detectado ainda." />
        </LinearLayout>

        <Button
            android:id="@+id/refreshButton"
            style="@style/NoPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Atualizar central" />

        <Button
            android:id="@+id/debugToggleButton"
            style="@style/NoSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Mostrar diagnóstico técnico" />

        <LinearLayout
            android:id="@+id/debugPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_no_metric"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                style="@style/NoSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIAGNÓSTICO" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-monospace"
                android:text="Nenhuma leitura capturada ainda."
                android:textColor="@color/no_text_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/NoBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="O ranking usa somente dados capturados. Quando o aplicativo não informa tempo, o NÓ não inventa retorno por hora e reduz a comparação ao que está disponível." />
    </LinearLayout>
</ScrollView>
