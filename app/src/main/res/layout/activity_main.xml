<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/no_navy"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                style="@style/NoLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NÓ" />

            <TextView
                style="@style/NoLogoDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="." />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-condensed"
            android:text="INTELIGÊNCIA PARA QUEM\nTRABALHA SOBRE RODAS"
            android:textColor="@color/no_white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            style="@style/NoBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Um profissional. Vários aplicativos. Uma única inteligência." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:background="@color/no_cyan" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/no_orange" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_no_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/NoSectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SISTEMA" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Leitura autorizada"
                        android:textColor="@color/no_white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_no_status_inactive"
                    android:text="VERIFICANDO"
                    android:textColor="@color/no_orange"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusDetailText"
                style="@style/NoBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Verificando o serviço de acessibilidade do NÓ." />

            <Button
                android:id="@+id/accessButton"
                style="@style/NoPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Abrir acessibilidade" />

            <Button
                android:id="@+id/refreshButton"
                style="@style/NoSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Atualizar análise" />
        </LinearLayout>

        <TextView
            style="@style/NoSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="DECISÃO ECONÔMICA" />

        <TextView
            style="@style/NoHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Última oportunidade" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_no_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/platformChipText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_no_chip"
                    android:text="AGUARDANDO OFERTA"
                    android:textColor="@color/no_cyan_soft"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/lastAnalysisText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/no_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/emptyOfferText"
                style="@style/NoBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Nenhuma oportunidade analisada ainda. Abra o Simulador de Corridas e selecione UberX ou 99Pop." />

            <LinearLayout
                android:id="@+id/offerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/classificationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_no_badge_high"
                    android:text="OPORTUNIDADE ALTA"
                    android:textColor="@color/no_cyan_soft"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/priceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="R$ 0,00"
                    android:textColor="@color/no_white"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/routeSummaryText"
                    style="@style/NoBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0,0 km total • 0 min" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_no_metric"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            style="@style/NoMetricLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RETORNO / KM" />

                        <TextView
                            android:id="@+id/perKmText"
                            style="@style/NoMetricValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="R$ 0,00" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_no_metric"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            style="@style/NoMetricLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RETORNO / HORA" />

                        <TextView
                            android:id="@+id/perHourText"
                            style="@style/NoMetricValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="R$ 0,00" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_no_metric"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            style="@style/NoMetricLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ATÉ PASSAGEIRO" />

                        <TextView
                            android:id="@+id/pickupKmText"
                            style="@style/NoMetricValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="0,0 km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_no_metric"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            style="@style/NoMetricLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRAJETO" />

                        <TextView
                            android:id="@+id/tripKmText"
                            style="@style/NoMetricValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="0,0 km" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/debugToggleButton"
            style="@style/NoSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Mostrar diagnóstico técnico" />

        <LinearLayout
            android:id="@+id/debugPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_no_metric"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                style="@style/NoSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIAGNÓSTICO" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-monospace"
                android:text="Nenhuma leitura capturada ainda."
                android:textColor="@color/no_text_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/NoBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="O NÓ adiciona uma camada de análise sobre os aplicativos de origem. A leitura depende de permissão explícita e deve respeitar os limites definidos pelo usuário e pelas plataformas." />
    </LinearLayout>
</ScrollView>
