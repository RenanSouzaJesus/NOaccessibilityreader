<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NO" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/no_navy</item>
        <item name="android:statusBarColor">@color/no_navy_deep</item>
        <item name="android:navigationBarColor">@color/no_navy_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/no_cyan</item>
    </style>

    <style name="NoLogo">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/no_white</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="NoLogoDot">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/no_cyan</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="NoSectionLabel">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/no_cyan</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="NoHeading">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@color/no_white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NoBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/no_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="NoPrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_no_button_primary</item>
        <item name="android:textColor">@color/no_navy_deep</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NoSecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_no_button_secondary</item>
        <item name="android:textColor">@color/no_white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NoMetricLabel">
        <item name="android:textColor">@color/no_text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="NoMetricValue">
        <item name="android:textColor">@color/no_white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
